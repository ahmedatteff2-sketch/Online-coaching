# Copy to .env (per-app) and fill in.
# This top-level file documents every variable used across the monorepo.

# ---- API ----
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitness_coaching?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=
COOKIE_SECURE=false
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000
RATE_LIMIT_LOGIN_MAX=10

# Default admin seeded by `npm run db:seed`
DEFAULT_ADMIN_PHONE=01025754947
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_NAME=Coach Admin

# ---- Web ----
VITE_API_URL=http://localhost:4000/api
